{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeTerm",
  "version": "0.1.17",
  "identifier": "com.darlingcy.vibeterm",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VibeTerm",
        "decorations": false,
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' asset: data:; img-src 'self' asset: data: blob:; connect-src 'self' tauri: asset:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "assets/icon.png",
      "assets/icon.ico"
    ]
  }
}
